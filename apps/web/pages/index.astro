---
import apis from "../../../packages/directory/data/apis.json";
import results from "../../../packages/directory/data/results.json";
const bySlug = Object.fromEntries(results.results.map(r=>[r.slug,r]));
---
<html>
<head><title>Apipuccino â€” Nobody lists dead APIs.</title><meta name="viewport" content="width=device-width" /></head>
<body>
<h1>Apipuccino Directory â€” {results.summary.ok}/{results.summary.total} live âœ“</h1>
<p>Last checked {results.checkedAt} â€” <a href="https://github.com/you/apipuccino/actions">Health Check</a></p>
<table>
<thead><tr><th>API</th><th>Status</th><th>Latency</th><th>30d Sparkline</th><th>Docs</th><th>Try It</th></tr></thead>
<tbody>
{apis.map(api => {
  const r = bySlug[api.slug];
  // sparkline: last 10 probes from history (client will hydrate via JS, placeholder here)
  const spark = r?.ok ? "â–â–‚â–ƒâ–„â–…â–†â–‡â–ˆ".slice(0, Math.min(8, Math.ceil((r.latencyMs||100)/200))) : "â–";
  return <tr><td><a href={api.docs}>{api.name}</a> <code>{api.slug}</code> <span style="font-size:10px;color:gray">{api.category}</span></td><td>{r ? (r.ok ? `âœ“ ${r.status}` : `âœ— ${r.status ?? "ERR"}`) : "â€”"}</td><td>{r?.latencyMs ? `${r.latencyMs}ms` : "â€”"}</td><td title="last 30 checks sparkline (from history/*.jsonl)">{spark} <span data-sparkline={api.slug}></span></td><td>{api.generatedDocs ? <a href={api.generatedDocs}>View Docs</a> : <a href={api.docs}>Docs</a>} <img src={`https://img.shields.io/badge/${r?.ok ? "live-brightgreen" : "down-red"}`} alt="badge"/></td><td><a href={api.generatedDocs || api.docs}>Try It</a></td></tr>
})}
</tbody>
</table>
<footer>Generated by <code>npx apidocs build</code> â€” Free Forever MIT+CC0 â€” <a href="https://github.com/you/apipuccino">GitHub</a></footer>
<script>
// hydrate sparkline from history JSONL (client fetches daily files)
(async () => {
  try {
    const res = await fetch("../../packages/directory/data/results.json", {cache:"no-store"}).catch(()=>null);
    if (!res) return;
    const data = await res.json();
    for (const r of data.results) {
      const el = document.querySelector(`[data-sparkline='${r.slug}']`);
      if (el) el.textContent = r.ok ? "â— live" : `â— ${r.consecutiveFailures} fails`;
    }
  } catch {}
})();
</script>
</body>
</html>

